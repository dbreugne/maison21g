<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tangent API Log Form View -->
    <record id="view_tangent_api_log_form" model="ir.ui.view">
        <field name="name">tangent.api.log.form</field>
        <field name="model">tangent.api.log</field>
        <field name="arch" type="xml">
            <form string="API Log" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="endpoint_url"/>
                            <field name="http_method"/>
                            <field name="response_status"/>
                            <field name="is_success"/>
                            <field name="processing_time"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="pos_order_count" string="POS Orders"/>
                            <field name="sale_order_count" string="Sale Orders"/>
                            <field name="total_order_count" string="Total Orders"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <group>
                                <field name="response_body" widget="text"/>
                                <field name="error_message" invisible="not error_message"/>
                                <field name="request_headers" widget="text"/>
                                <field name="request_params" widget="text"/>
                                <field name="request_body" widget="text"/>
                            </group>
                        </page>

                        <page string="POS Orders" name="pos_orders">
                            <field name="pos_order_ids" readonly="1">
                                <tree string="POS Orders" create="false" edit="false">
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="partner_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="state"/>
                                    <field name="session_id"/>
                                    <field name="config_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Sale Orders" name="sale_orders">
                            <field name="sale_order_ids" readonly="1">
                                <tree string="Sale Orders" create="false" edit="false">
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="partner_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="state"/>
                                    <field name="user_id"/>
                                    <field name="team_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tangent API Log Tree View -->
    <record id="view_tangent_api_log_tree" model="ir.ui.view">
        <field name="name">tangent.api.log.tree</field>
        <field name="model">tangent.api.log</field>
        <field name="arch" type="xml">
            <tree string="API Logs" create="false" decoration-success="is_success" decoration-danger="not is_success">
                <field name="create_date"/>
                <field name="name"/>
                <field name="config_id"/>
                <field name="endpoint_url"/>
                <field name="http_method"/>
                <field name="response_status"/>
                <field name="is_success"/>
                <field name="processing_time"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Tangent API Log Search View -->
    <record id="view_tangent_api_log_search" model="ir.ui.view">
        <field name="name">tangent.api.log.search</field>
        <field name="model">tangent.api.log</field>
        <field name="arch" type="xml">
            <search string="Search API Logs">
                <field name="name"/>
                <field name="endpoint_url"/>
                <field name="config_id"/>
                <filter string="Successful" name="successful" domain="[('is_success', '=', True)]"/>
                <filter string="Failed" name="failed" domain="[('is_success', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="API Config" name="config_id" domain="[]" context="{'group_by': 'config_id'}"/>
                    <filter string="HTTP Method" name="http_method" domain="[]" context="{'group_by': 'http_method'}"/>
                    <filter string="Status" name="is_success" domain="[]" context="{'group_by': 'is_success'}"/>
                    <filter string="Date" name="create_date" domain="[]" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tangent API Log Action -->
    <record id="action_tangent_api_log" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">tangent.api.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_create_date': 1, 'create': False}</field>
        <!-- <field name="flags">{'create': False, 'write': False, 'delete': False}</field> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No API logs yet
            </p>
            <p>
                API logs will be created automatically when API requests are made.
            </p>
        </field>
    </record>

</odoo>
