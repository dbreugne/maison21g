    <menuitem
        id="tangent_api_menu"
        name="Tangent API"
        parent="base.menu_administration"
    />

    <!-- Tangent API Configuration Menu -->
    <menuitem id="menu_tangent_api_config"
              name="API Configuration"
              parent="tangent_api_menu"
              action="action_tangent_api_config"
              sequence="10"/>

    <!-- Add API Logs menu under Tangent API menu -->
    <menuitem id="menu_tangent_api_log"
              name="API Logs"
              parent="tangent_api_menu"
              action="action_tangent_api_log"
              sequence="20"/>
</odoo>
