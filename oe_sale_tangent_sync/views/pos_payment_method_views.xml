<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="pos_payment_method_tree">
            <field name="name">pos.payment.method.tree</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="tangent_payment_type" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
    <data>
        <record model="ir.ui.view" id="pos_payment_method_form">
            <field name="name">pos.payment.method.form</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="tangent_payment_type"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>