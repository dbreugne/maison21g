<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>   
    <record id="wizard_message_form" model="ir.ui.view">
      <field name="name">Message wizard</field>
      <field name="model">wizard.message</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Message" version="7.0">
	  <separator string="Message" colspan="6"/>
	  <field name="text" colspan="4" nolabel="1" readonly="1"/>															
	  <newline/>
	  <separator colspan="6"/>
	  <footer>
	    <button special="cancel" class="oe_highlight" string="Close" />
	  </footer>								
        </form>
      </field>
    </record>
        
    <record id="wizard_message_action" model="ir.actions.act_window">
      <field name="name">wizard.message</field>
      <field name="res_model">wizard.message</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>
    
    <record id="generate_record_form" model="ir.ui.view">
      <field name="name">generate record</field>
      <field name="model">generate.record</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Message" version="7.0">
	  <group>
	    <group>
	      <field name="model" readonly="1" />
	      <field name="date"  />
	    </group>
	    <group>
	      <field name="hours"  /> 
	    </group>
	  </group>	
	  <group>
	  </group>													
	  <newline/> 
	  <footer>
            <button name="create_order_record" string="Generate" type="object" class="btn-primary"/>
	    <button special="cancel" class="oe_highlight" string="Close" />
	  </footer>								
        </form>
      </field>
    </record>
        
    <record id="generate_record_action" model="ir.actions.act_window">
      <field name="name">Generate</field>
      <field name="res_model">generate.record</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>    
    
    <menuitem id="menu_generate_order" parent="sync_database.menu_marina_bay" sequence="13" action="generate_record_action"/>
  </data>	
</odoo>
