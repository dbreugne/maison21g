<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="dev_pos_reprint_orders.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('header-row')]//div[@name='delete']" position="before">
            
            <div class="col end narrow p-2" name="Print">Print</div>
        </xpath>
        <xpath expr="//div[hasclass('order-row')]//div[@name='delete']" position="before">
            <div  class="col end narrow p-2" name="Print">
                <button class='edit-partner-button btn btn-light border'    t-on-click="() => this.onClickRePrint(order)" t-on-dblclick="() => order.locked ? ()=>{} : this._setOrder(order)"><i class="fa fa-print"></i><span style="margin-left: 4px;">Print</span></button>
            </div>
            
        </xpath>
        
    </t>
</templates>