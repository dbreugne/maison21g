<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fix_ecom_invoice_tax_wizard_form_view" model="ir.ui.view">
        <field name="name">fix.ecom.invoice.tax.wizard.form</field>
        <field name="model">fix.ecom.invoice.tax.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix ECOM Invoice GST Tax Codes">
                <sheet>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="include_posted"/>
                        <field name="include_paid"/>
                    </group>
                    <group string="Preview">
                        <field name="invoice_count" string="Invoices to Fix"/>
                        <field name="line_count" string="Invoice Lines Affected"/>
                        <field name="skipped_count" string="Invoices Skipped"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong> Paid invoices using <b>[old] Sales Tax 9% SR</b>
                        (price-inclusive) can be fixed safely — the invoice total does not change
                        so payment reconciliation is preserved.
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>Rule:</strong>
                        Shipping address in Singapore → Sales Tax 9% SR |
                        Shipping address overseas → Sales Tax 0% ZR
                    </div>
                </sheet>
                <footer>
                    <button name="action_fix_taxes" string="Apply Fix" type="object"
                            class="btn-primary"
                            confirm="This will update tax codes on the selected invoices. Posted invoices will be temporarily reset to draft. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fix_ecom_invoice_tax_wizard" model="ir.actions.act_window">
        <field name="name">Fix ECOM GST Tax Codes</field>
        <field name="res_model">fix.ecom.invoice.tax.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_fix_ecom_invoice_tax"
              name="Fix ECOM GST Tax Codes"
              action="action_fix_ecom_invoice_tax_wizard"
              parent="account.menu_finance_entries_management"
              sequence="99"/>

    <!-- Rollback wizard -->
    <record id="rollback_inv_tax_wizard_form_view" model="ir.ui.view">
        <field name="name">rollback.inv.tax.wizard.form</field>
        <field name="model">rollback.inv.tax.wizard</field>
        <field name="arch" type="xml">
            <form string="Rollback Incorrectly Changed Invoice Taxes">
                <sheet>
                    <div class="alert alert-danger" role="alert">
                        <strong>EMERGENCY ROLLBACK</strong> — This wizard restores the original
                        tax codes on invoices where taxes were incorrectly overwritten by a module
                        update. It uses Odoo's own change history to determine the original tax.
                    </div>
                    <group>
                        <field name="cutoff_date" string="Module Update Was Run After"/>
                    </group>
                    <group string="Preview">
                        <field name="affected_count" string="Invoices to Restore"/>
                        <field name="paid_count" string="Paid Invoices (Skipped)"/>
                    </group>
                    <field name="preview_text" string="Invoice List" widget="text" readonly="1"/>
                    <div class="alert alert-warning" role="alert" attrs="{'invisible': [('paid_count', '=', 0)]}">
                        <strong>Paid invoices are skipped.</strong> These must be corrected manually
                        (credit note + new invoice, or adjust journal entries).
                    </div>
                </sheet>
                <footer>
                    <button name="action_rollback"
                            string="Rollback Taxes to Original"
                            type="object"
                            class="btn-danger"
                            confirm="This will reset taxes on the listed invoices back to their original values. Posted invoices will be briefly set to draft then re-confirmed. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rollback_inv_tax_wizard" model="ir.actions.act_window">
        <field name="name">Rollback Invoice Tax Codes</field>
        <field name="res_model">rollback.inv.tax.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_rollback_inv_tax"
              name="Rollback Invoice Tax Codes"
              action="action_rollback_inv_tax_wizard"
              parent="account.menu_finance_entries_management"
              sequence="100"/>
</odoo>
