<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_custom_new" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.purchase</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree/field[@name='product_qty']" position="before">
                <field name="custom_sale_id" widget="many2many_tags"/>
                <field name="hq_category_id"  invisible="1"/>
                <field name="customer_id" widget="many2many_tags" domain="[('customer_rank','=',1)]"  />
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_inherit_custom_new" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.custom.sale</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="custom_sale_id" widget="many2many_tags" optional="show"/>
                <field name="customer_id" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_inherit_custom_new" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit.custom.sale</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="custom_sale_id" widget="many2many_tags" optional="show"/>
                <field name="customer_id" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_inherit_custom_new" model="ir.ui.view">
        <field name="name">request.quotation.select.inherit.custom.sale</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="custom_sale_id"/>
                <field name="customer_id"/>
            </xpath>
            <xpath expr="//group/filter[@name='vendor']" position="after">
                <filter string="Sale Order" name="custom_sale_id" domain="[]"
                        context="{'group_by': 'custom_sale_id'}"/>
                <filter string="Customer" name="customer_id" domain="[]"
                        context="{'group_by': 'customer_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_search_inherit_custom_new" model="ir.ui.view">
        <field name="name">purchase.order.select.inherit.custom.sale</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="custom_sale_id"/>
                <field name="customer_id"/>
            </xpath>
            <xpath expr="//group/filter[@name='vendor']" position="after">
                <filter string="Sale Order" name="custom_sale_id" domain="[]"
                        context="{'group_by': 'custom_sale_id'}"/>
                <filter string="Customer" name="customer_id" domain="[]"
                        context="{'group_by': 'customer_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
