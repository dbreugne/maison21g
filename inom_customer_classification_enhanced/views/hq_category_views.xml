<odoo>
    <record id="view_hq_list" model="ir.ui.view">
        <field name="name">inom.hq.category.list</field>
        <field name="model">inom.hq.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>



    <record id="view_inom_hq_category_form" model="ir.ui.view">
        <field name="name">inom.hq.category.form</field>
        <field name="model">inom.hq.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hq" model="ir.actions.act_window">
        <field name="name">HQ Categories</field>
        <field name="res_model">inom.hq.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>