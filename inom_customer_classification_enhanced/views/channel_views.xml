<odoo>
    <record id="view_channel_list" model="ir.ui.view">
        <field name="name">inom.channel.list</field>
        <field name="model">inom.channel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_inom_channel_form" model="ir.ui.view">
        <field name="name">inom.channel.form</field>
        <field name="model">inom.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">inom.channel</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>